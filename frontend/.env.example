# Required by the API in local and Vercel environments.
# Paste your MongoDB Atlas connection string; URL-encode special characters in credentials.
MONGODB_URI=
# Generate a unique random value of at least 32 bytes. Never reuse this example file's value.
JWT_SECRET=

# Optional runtime settings.
JWT_EXPIRE=24h
FRONTEND_URL=
DELIVERY_FEE_DEFAULT=0

# Local server settings. Vercel provides NODE_ENV and VERCEL_URL automatically.
NODE_ENV=development
PORT=5000

# Set only while running `npm run seed-admin` against the intended database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Restaurant Administrator
