{
  "name": "ramada-restaurant-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"vite\"",
    "dev:frontend": "vite",
    "dev:api": "node server/src/server.js",
    "build": "vite build",
    "vercel-build": "npm run build",
    "start": "npm run build && concurrently -k \"npm:dev:api\" \"vite preview --host 0.0.0.0\"",
    "preview": "vite preview",
    "test": "node --test",
    "seed-admin": "node server/src/scripts/seedAdmin.js",
    "seed-menu": "node server/src/scripts/seedMenu.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.292.0",
    "mongoose": "^7.6.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.5",
    "concurrently": "^8.2.0"
  }
}
